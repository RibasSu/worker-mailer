{
  "name": "@ribassu/worker-mailer",
  "version": "1.3.3",
  "packageManager": "bun@1.3.14",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.mjs",
      "require": "./dist/queue.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cloudflare",
    "workers",
    "cloudflare-workers",
    "email",
    "smtp"
  ],
  "author": "André Ribas (@RibasSu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RibasSu/worker-mailer.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/RibasSu/worker-mailer",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "format": "prettier '**/*.{json,ts,js,cjs,mjs,md}' --write --ignore-path .gitignore"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@types/libqp": "^1.1.3",
    "@types/node": "^26.1.1",
    "letterparser": "^0.1.8",
    "libqp": "^2.1.1",
    "prettier": "^3.9.5",
    "tsdown": "0.22.9",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
